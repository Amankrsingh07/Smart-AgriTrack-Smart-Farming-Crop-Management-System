generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Season {
  KHARIF
  RABI
  ZAID
}

enum CropStatus {
  PLANNED
  ACTIVE
  HARVESTED
  COMPLETED
}

enum ExpenseCategory {
  SEEDS
  FERTILIZER
  PESTICIDES
  LABOR
  IRRIGATION
  MACHINERY
  TRANSPORTATION
  OTHER
}

enum WaterLevel {
  LOW
  MEDIUM
  HIGH
}

enum WaterMeasure {
  CROP_ETC
  EFFECTIVE_RAINFALL
  IRRIGATION_REQUIREMENT
  CROP_WATER_PLUS_EFFECTIVE_RAINFALL
}

enum WaterDataStatus {
  VERIFIED
  ESTIMATED
}

model User {
  protectionAssessments CropProtectionAssessment[]
  protectionGrant CropProtectionExpertGrant?
  fertilizerProducts FertilizerProduct[]
  id                              String                            @id @default(cuid())
  name                            String
  email                           String                            @unique
  passwordHash                    String
  phone                           String?
  language                        String                            @default("en") @db.VarChar(5)
  createdAt                       DateTime                          @default(now())
  profile                         FarmerProfile?
  farms                           Farm[]
  expenses                        Expense[]
  budgets                         Budget[]
  irrigationSchedules             IrrigationSchedule[]
  rainfallObservations            RainfallObservation[]
  marketQuotes                    MarketQuote[]
  inventoryThresholds             InventoryThreshold[]
  cropRecommendations             CropRecommendation[]
  fertilizerRecommendationHistory FertilizerRecommendationHistory[]
  alerts                          Alert[]
  harvestNotifications            HarvestNotification[]
  harvestReminderSettings         HarvestReminderSettings?
  pushSubscriptions               PushSubscription[]
  cropCalendarEvents              CropCalendarEvent[]
  cropCalendars                   CropCalendar[]
  cropCalendarNotifications       CropCalendarNotification[]
  assistantConversations          AssistantConversation[]
}

model FarmerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  state           String?
  district        String?
  village         String?
  preferredSeason Season?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Farm {
  id            String                            @id @default(cuid())
  userId        String
  name          String
  state         String
  district      String
  village       String?
  latitude      Decimal?                          @db.Decimal(9, 6)
  longitude     Decimal?                          @db.Decimal(9, 6)
  description   String?                           @db.Text
  createdAt     DateTime                          @default(now())
  user          User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields        Field[]
  cropCalendars CropCalendar[]
  expenses      Expense[]
  soilTests     FertilizerRecommendationHistory[]

  @@index([userId])
}

model Field {
  id                String                            @id @default(cuid())
  farmId            String
  name              String
  area              Decimal                           @db.Decimal(10, 2)
  areaUnit          String                            @default("acre")
  soilType          String
  soilTexture       String?
  irrigationMethod  String
  irrigationSource  String?
  waterAvailability WaterLevel                        @default(MEDIUM)
  soilPh            Decimal?                          @db.Decimal(4, 2)
  notes             String?                           @db.Text
  farm              Farm                              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropCycles        CropCycle[]
  expenses          Expense[]
  soilTests         FertilizerRecommendationHistory[]

  @@index([farmId])
}

model Crop {
  id                    String                            @id @default(cuid())
  name                  String                            @unique
  seasons               String
  soilTypes             String                            @db.Text
  waterNeed             WaterLevel
  minRainfallMm         Int?
  maxRainfallMm         Int?
  minTempC              Decimal?                          @db.Decimal(4, 1)
  maxTempC              Decimal?                          @db.Decimal(4, 1)
  description           String?                           @db.Text
  source                String?
  sourceUrl             String?                           @db.Text
  illustrative          Boolean                           @default(true)
  cycles                CropCycle[]
  locationSuitabilities CropLocationSuitability[]
  cropSeasons           CropSeason[]
  soilRequirements      CropSoilRequirement[]
  climateRequirement    CropClimateRequirement?
  waterStages           CropWaterStage[]
  districtSuitabilities CropDistrictSuitability[]
  recommendationItems   CropRecommendationItem[]
  calendars             CropCalendar[]
  soilTests             FertilizerRecommendationHistory[]
}

model State {
  id               String     @id @default(cuid())
  lgdCode          String     @unique
  name             String
  isUnionTerritory Boolean    @default(false)
  isActive         Boolean    @default(true)
  source           String?
  sourceDate       DateTime?  @db.Date
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  districts        District[]

  @@index([name])
}

model District {
  id                String                    @id @default(cuid())
  lgdCode           String                    @unique
  name              String
  stateId           String
  latitude          Decimal?                  @db.Decimal(9, 6)
  longitude         Decimal?                  @db.Decimal(9, 6)
  isActive          Boolean                   @default(true)
  source            String?
  sourceDate        DateTime?                 @db.Date
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  state             State                     @relation(fields: [stateId], references: [id], onDelete: Restrict)
  cropSuitabilities CropDistrictSuitability[]
  recommendations   CropRecommendation[]

  @@unique([stateId, name])
  @@index([stateId, isActive])
}

model CropSeason {
  id                    String                    @id @default(cuid())
  cropId                String
  season                Season
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  source                String?
  sourceUrl             String?                   @db.Text
  crop                  Crop                      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  districtSuitabilities CropDistrictSuitability[]
  recommendationItems   CropRecommendationItem[]
  waterStages           CropWaterStage[]

  @@unique([cropId, season])
  @@unique([id, cropId])
  @@index([season])
}

model CropSoilRequirement {
  id                       String   @id @default(cuid())
  cropId                   String
  soilType                 String
  minPh                    Decimal? @db.Decimal(4, 2)
  maxPh                    Decimal? @db.Decimal(4, 2)
  minNitrogenKgHa          Decimal? @db.Decimal(10, 2)
  maxNitrogenKgHa          Decimal? @db.Decimal(10, 2)
  minPhosphorusKgHa        Decimal? @db.Decimal(10, 2)
  maxPhosphorusKgHa        Decimal? @db.Decimal(10, 2)
  minPotassiumKgHa         Decimal? @db.Decimal(10, 2)
  maxPotassiumKgHa         Decimal? @db.Decimal(10, 2)
  minOrganicCarbonPercent  Decimal? @db.Decimal(5, 3)
  maxOrganicCarbonPercent  Decimal? @db.Decimal(5, 3)
  minSoilMoisturePercent   Decimal? @db.Decimal(5, 2)
  maxSoilMoisturePercent   Decimal? @db.Decimal(5, 2)
  fertilizerRecommendation String?  @db.Text
  source                   String?
  sourceUrl                String?  @db.Text
  notes                    String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  crop                     Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, soilType])
  @@index([soilType])
}

model CropClimateRequirement {
  id                 String   @id @default(cuid())
  cropId             String   @unique
  minTemperatureC    Decimal? @db.Decimal(5, 2)
  maxTemperatureC    Decimal? @db.Decimal(5, 2)
  minRainfallMm      Decimal? @db.Decimal(8, 2)
  maxRainfallMm      Decimal? @db.Decimal(8, 2)
  minHumidityPercent Decimal? @db.Decimal(5, 2)
  maxHumidityPercent Decimal? @db.Decimal(5, 2)
  cropDurationDays   Int?
  source             String?
  sourceUrl          String?  @db.Text
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  crop               Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
}

model CropWaterStage {
  id                         String          @id @default(cuid())
  cropId                     String
  cropSeasonId               String?
  stageName                  String
  startDay                   Int?
  endDay                     Int?
  cropCoefficient            Decimal?        @db.Decimal(5, 3)
  rootDepthMeters            Decimal?        @db.Decimal(5, 2)
  allowableDepletionFraction Decimal?        @db.Decimal(5, 3)
  publicationDate            DateTime?       @db.Date
  publicationTitle           String?         @db.VarChar(255)
  publicationYear            Int?
  tableReference             String?         @db.VarChar(120)
  verifiedAt                 DateTime?       @db.Date
  isFullSeasonTotal          Boolean         @default(false)
  waterMeasure               WaterMeasure?
  waterRequirementMm         Decimal?        @db.Decimal(8, 2)
  minimumWaterRequirementMm  Decimal?        @db.Decimal(8, 2)
  maximumWaterRequirementMm  Decimal?        @db.Decimal(8, 2)
  source                     String?
  sourceUrl                  String?         @db.Text
  notes                      String?         @db.Text
  dataStatus                 WaterDataStatus @default(ESTIMATED)
  geographicScope            String?         @db.VarChar(160)
  irrigationMethod           String?         @db.VarChar(40)
  supportingSource           String?         @db.VarChar(255)
  supportingSourceUrl        String?         @db.Text
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  crop                       Crop            @relation(fields: [cropId], references: [id], onDelete: Cascade)
  cropSeason                 CropSeason?     @relation(fields: [cropSeasonId, cropId], references: [id, cropId], onDelete: Cascade)

  @@unique([cropId, cropSeasonId, stageName, waterMeasure])
  @@index([cropId, startDay])
  @@index([cropSeasonId, waterMeasure])
}

model CropDistrictSuitability {
  id           String     @id @default(cuid())
  cropId       String
  districtId   String
  cropSeasonId String
  notes        String?    @db.Text
  source       String?
  sourceUrl    String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  crop         Crop       @relation(fields: [cropId], references: [id], onDelete: Cascade)
  district     District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  cropSeason   CropSeason @relation(fields: [cropSeasonId, cropId], references: [id, cropId], onDelete: Cascade)

  @@unique([cropId, districtId, cropSeasonId])
  @@index([districtId, cropSeasonId])
}

model CropRecommendation {
  id              String                   @id @default(cuid())
  userId          String
  stateName       String                   @default("")
  blockName       String?
  villageName     String?
  districtId      String?
  season          Season
  inputSnapshot   Json?
  modelVersion    String                   @default("rules-v1")
  weatherSnapshot Json?
  explanation     Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district        District?                @relation(fields: [districtId], references: [id], onDelete: SetNull)
  items           CropRecommendationItem[]

  @@index([userId, createdAt])
  @@index([districtId, season])
}

model CropRecommendationItem {
  id               String             @id @default(cuid())
  recommendationId String
  cropId           String
  cropSeasonId     String
  rank             Int
  explanation      Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  recommendation   CropRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  crop             Crop               @relation(fields: [cropId], references: [id], onDelete: Restrict)
  cropSeason       CropSeason         @relation(fields: [cropSeasonId, cropId], references: [id, cropId], onDelete: Restrict)

  @@unique([recommendationId, rank])
  @@index([cropId, cropSeasonId])
}

model CropLocationSuitability {
  id        String  @id @default(cuid())
  cropId    String
  state     String
  district  String?
  season    Season
  notes     String? @db.Text
  source    String?
  sourceUrl String? @db.Text
  crop      Crop    @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, state, district, season])
  @@index([state, season])
}

model CropCycle {
  assistantConversations AssistantConversation[]
  protectionAssessments CropProtectionAssessment[]
  fertilizerPlans FertilizerPlan[]
  fertilizerApplications FertilizerApplication[]
  fertilizerAnalyses FertilizerAnalysis[]
  id                   String                            @id @default(cuid())
  fieldId              String
  cropId               String
  cropVariety          String?                           @db.VarChar(120)
  season               Season
  sowingDate           DateTime?
  expectedHarvestDate  DateTime?
  expectedHarvestQuantity Decimal? @db.Decimal(12, 3)
  expectedHarvestUnit String? @db.VarChar(24)
  actualHarvestDate    DateTime?
  cropDurationDays     Int?
  growthStageUpdatedAt DateTime?
  status               CropStatus                        @default(PLANNED)
  growthStage          String?                           @db.VarChar(60)
  seedQuantity         Decimal?                          @db.Decimal(10, 2)
  seedCost             Decimal?                          @db.Decimal(12, 2)
  waterRequirement     String?
  notes                String?                           @db.Text
  createdAt            DateTime                          @default(now())
  field                Field                             @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  crop                 Crop                              @relation(fields: [cropId], references: [id])
  expenses             Expense[]
  productions          Production[]
  sales                Sale[]
  schedules            IrrigationSchedule[]
  rainfallObservations RainfallObservation[]
  harvestNotification  HarvestNotification?
  calendarEvents       CropCalendarEvent[]
  cropCalendar         CropCalendar?
  soilTests            FertilizerRecommendationHistory[]

  @@index([fieldId, status])
}

model CropCalendarEvent {
  id          String     @id @default(cuid())
  userId      String
  cropCycleId String?
  title       String     @db.VarChar(120)
  eventDate   DateTime   @db.Date
  notes       String?    @db.VarChar(500)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropCycle   CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)

  @@index([userId, eventDate])
  @@index([cropCycleId])
}

model CropCalendar {
  id                   String                 @id @default(cuid())
  userId               String
  farmId               String
  cropCycleId          String                 @unique
  cropId               String
  cropVariety          String?                @db.VarChar(120)
  state                String                 @db.VarChar(100)
  district             String                 @db.VarChar(100)
  sowingDate           DateTime               @db.Date
  landArea             Decimal                @db.Decimal(10, 2)
  areaUnit             String                 @db.VarChar(16)
  soilType             String                 @db.VarChar(80)
  irrigationMethod     String                 @db.VarChar(80)
  estimatedHarvestDate DateTime?              @db.Date
  status               String                 @default("ACTIVE") @db.VarChar(16)
  datasetVersion       String                 @db.VarChar(40)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm                 Farm                   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop                 Crop                   @relation(fields: [cropId], references: [id], onDelete: Restrict)
  cropCycle            CropCycle              @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  activities           CropCalendarActivity[]

  @@index([userId, status, sowingDate])
  @@index([farmId, sowingDate])
}

model CropCalendarActivity {
  id                   String                     @id @default(cuid())
  calendarId           String
  activityKey          String                     @db.VarChar(120)
  activityName         String                     @db.VarChar(160)
  activityType         String                     @db.VarChar(32)
  growthStage          String?                    @db.VarChar(80)
  scheduledDate        DateTime                   @db.Date
  actualCompletionDate DateTime?
  description          String                     @db.Text
  recommendation       String?                    @db.Text
  status               String                     @default("PENDING") @db.VarChar(16)
  isWeatherAdjusted    Boolean                    @default(false)
  isManuallyModified   Boolean                    @default(false)
  notes                String?                    @db.VarChar(500)
  source               String?                    @db.VarChar(255)
  sourceUrl            String?                    @db.Text
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  calendar             CropCalendar               @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  notifications        CropCalendarNotification[]

  @@unique([calendarId, activityKey])
  @@index([calendarId, scheduledDate, status])
}

model CropCalendarNotification {
  id               String               @id @default(cuid())
  userId           String
  activityId       String
  notificationDate DateTime             @db.Date
  message          String               @db.VarChar(500)
  isRead           Boolean              @default(false)
  createdAt        DateTime             @default(now())
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity         CropCalendarActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, notificationDate])
  @@index([userId, isRead, notificationDate])
}

model Expense {
  fertilizerApplication FertilizerApplication?
  id               String          @id @default(cuid())
  userId           String
  farmId           String
  fieldId          String?
  cropCycleId      String?
  category         ExpenseCategory
  amount           Decimal         @db.Decimal(12, 2)
  date             DateTime        @default(now())
  description      String?
  receiptReference String?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm             Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  field            Field?          @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  cropCycle        CropCycle?      @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Budget {
  id               String  @id @default(cuid())
  userId           String
  month            Int
  year             Int
  amount           Decimal @db.Decimal(12, 2)
  thresholdPercent Int     @default(80)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model Production {
  id             String              @id @default(cuid())
  cropCycleId    String
  harvestDate    DateTime
  quantity       Decimal             @db.Decimal(12, 3)
  unit           String
  grade          String?
  notes          String?             @db.Text
  storageDetails String?             @db.Text
  yieldPerAcre   Decimal?            @db.Decimal(12, 3)
  cropCycle      CropCycle           @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  sales          Sale[]
  lossAssessment CropLossAssessment?
  storageInspections StorageInspection[]
}

model StorageInspection {
  productionId String
  version Int
  inspectedOn DateTime @db.Date
  findings Json
  createdAt DateTime @default(now())
  production Production @relation(fields: [productionId], references: [id], onDelete: Restrict)

  attachments StorageInspectionAttachment[]

  @@id([productionId, version])
}

model StorageInspectionAttachment {
  id String @id @default(cuid())
  productionId String
  version Int
  filename String
  mediaType String
  content Bytes @db.MediumBlob
  inspection StorageInspection @relation(fields: [productionId, version], references: [productionId, version], onDelete: Cascade)

  @@index([productionId, version])
}

model Sale {
  id           String      @id @default(cuid())
  cropCycleId  String
  productionId String?
  saleDate     DateTime
  quantity     Decimal     @db.Decimal(12, 3)
  unit         String
  pricePerUnit Decimal     @db.Decimal(12, 2)
  totalRevenue Decimal     @db.Decimal(14, 2)
  buyerName    String?
  notes        String?     @db.Text
  cropCycle    CropCycle   @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  production   Production? @relation(fields: [productionId], references: [id], onDelete: SetNull)

  @@index([cropCycleId, saleDate])
}

model MarketQuote {
  id        String   @id @default(cuid())
  userId    String
  crop      String
  mandi     String
  price     Decimal  @db.Decimal(12, 2)
  unit      String
  quoteDate DateTime
  source    String   @default("Manual user entry")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, quoteDate])
}

model InventoryThreshold {
  id        String   @id @default(cuid())
  userId    String
  cropName  String
  unit      String
  lowStock  Decimal  @db.Decimal(12, 3)
  highStock Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cropName, unit])
  @@index([userId])
}

model IrrigationSchedule {
  id                            String    @id @default(cuid())
  clientTransactionId           String?   @unique
  userId                        String
  cropCycleId                   String
  scheduledAt                   DateTime
  durationMinutes               Int?
  waterQuantity                 Decimal?  @db.Decimal(12, 2)
  soilMoisturePercent           Decimal?  @db.Decimal(5, 2)
  soilMoistureStatus            String?   @db.VarChar(12)
  lastWateredAt                 DateTime? @db.Date
  soilMoistureSource            String?   @db.VarChar(24)
  observedRainfallMm            Decimal?  @db.Decimal(8, 2)
  advisoryStatus                String?   @db.VarChar(24)
  isCheckOnly                   Boolean   @default(false)
  recommendedQuantityLiters     Decimal?  @db.Decimal(14, 2)
  actualQuantityLiters          Decimal?  @db.Decimal(14, 2)
  actualQuantityUnit            String?   @db.VarChar(16)
  status                        String?   @db.VarChar(16)
  netQuantityLiters             Decimal?  @db.Decimal(14, 2)
  areaSquareMeters              Decimal?  @db.Decimal(12, 2)
  areaAcres                     Decimal?  @db.Decimal(10, 4)
  netIrrigationDepthMm          Decimal?  @db.Decimal(8, 2)
  seasonalRequirementMm         Decimal?  @db.Decimal(8, 2)
  cropGrowthStage               String?   @db.VarChar(60)
  irrigationDepthMm             Decimal?  @db.Decimal(8, 2)
  efficiencyPercent             Decimal?  @db.Decimal(5, 2)
  flowRateLitersPerMinute       Decimal?  @db.Decimal(10, 2)
  systemFlowRateLitersPerMinute Decimal?  @db.Decimal(12, 2)
  flowRateScope                 String?   @db.VarChar(10)
  simultaneousEmitters          Int?
  recommendationSource          String?   @db.Text
  recommendationNotes           String?   @db.Text
  irrigationSource              String?
  completedAt                   DateTime?
  method                        String?
  notes                         String?
  user                          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropCycle                     CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt, completedAt])
}

model RainfallObservation {
  id                         String    @id @default(cuid())
  clientTransactionId        String?   @unique
  userId                     String
  cropCycleId                String
  rainfallDate               DateTime  @db.Date
  moistureMeasuredDate       DateTime? @db.Date
  soilFieldCapacityPercent   Decimal?  @db.Decimal(5, 2)
  soilCurrentMoisturePercent Decimal?  @db.Decimal(5, 2)
  soilRootZoneDepthM         Decimal?  @db.Decimal(5, 2)
  grossRainfallMm            Decimal   @db.Decimal(8, 2)
  runoffLossMm               Decimal?  @db.Decimal(8, 2)
  drainageLossMm             Decimal?  @db.Decimal(8, 2)
  effectiveRainfallMm        Decimal?  @db.Decimal(8, 2)
  source                     String    @db.VarChar(32)
  calculationStatus          String    @db.VarChar(48)
  notes                      String?   @db.VarChar(500)
  recordedAt                 DateTime  @default(now())
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropCycle                  CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([userId, rainfallDate])
  @@index([cropCycleId, rainfallDate])
}

model FertilizerRecommendationHistory {
  id          String     @id @default(cuid())
  userId      String
  input       Json
  result      Json
  createdAt   DateTime   @default(now())
  sampleDate  DateTime?  @db.Date
  farmId      String?
  fieldId     String?
  cropId      String?
  cropCycleId String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm        Farm?      @relation(fields: [farmId], references: [id], onDelete: SetNull)
  field       Field?     @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  crop        Crop?      @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropCycle   CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)

  attachments SoilReportAttachment[]

  @@index([userId, createdAt])
  @@index([userId, fieldId, sampleDate])
  @@index([farmId])
  @@index([fieldId])
  @@index([cropId])
  @@index([cropCycleId])
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String    @db.Text
  href      String?
  dedupeKey String?
  readAt    DateTime?
  completedAt DateTime?
  cropName String?
  productionId String?
  dueOn DateTime? @db.Date
  priority String?
  actionId String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model HarvestNotification {
  id             String    @id @default(cuid())
  userId         String
  cropCycleId    String    @unique
  expectedDate   DateTime  @db.Date
  title          String
  message        String    @db.Text
  weatherWarning String?   @db.Text
  href           String
  readAt         DateTime?
  status         String    @default("PENDING") @db.VarChar(20)
  firstSentAt    DateTime?
  lastSentAt     DateTime?
  nextReminderAt DateTime
  snoozedUntil   DateTime?
  reminderCount  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropCycle      CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, nextReminderAt])
  @@index([status, nextReminderAt])
}

model HarvestReminderSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  reminderIntervalHours Int      @default(24)
  pushEnabled           Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.VarChar(512)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

// Private original documents. Ownership and field/cycle links inherit from report.
model SoilReportAttachment {
  id        String                          @id @default(cuid())
  reportId  String
  filename  String                          @db.VarChar(200)
  mediaType String                          @db.VarChar(40)
  size      Int
  sha256    String                          @db.Char(64)
  content   Bytes                           @db.LongBlob
  createdAt DateTime                        @default(now())
  report    FertilizerRecommendationHistory @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

// One reconciled allocation per existing harvest lot; no duplicate production.
model CropLossAssessment {
  id                  String     @id @default(cuid())
  productionId        String     @unique
  assessedDate        DateTime   @db.Date
  marketable          Decimal    @db.Decimal(12, 3)
  damaged             Decimal    @db.Decimal(12, 3)
  wasted              Decimal    @db.Decimal(12, 3)
  unit                String     @db.VarChar(24)
  harvestedSnapshot   Decimal    @db.Decimal(12, 3)
  quantitiesConfirmed Boolean    @default(false)
  evidence            String     @db.VarChar(500)
  pricePerUnit        Decimal?   @db.Decimal(12, 2)
  damagedRecovery     Decimal?   @db.Decimal(14, 2)
  priceEvidence       String?    @db.VarChar(500)
  priceConfirmed      Boolean    @default(false)
  cause               String     @db.VarChar(80)
  notes               String?    @db.Text
  version             Int        @default(1)
  revisions           Json
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  production          Production @relation(fields: [productionId], references: [id], onDelete: Restrict)

  @@index([assessedDate])
}

// Additive decision-support records. Existing soil history remains authoritative.
model FertilizerReference {
  id String @id
  metadata Json
  createdAt DateTime @default(now())
  plans FertilizerPlan[]
}

model FertilizerPlan {
  id String @id @default(cuid())
  cropCycleId String
  referenceId String
  input Json
  result Json
  createdAt DateTime @default(now())
  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Restrict)
  reference FertilizerReference @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  applications FertilizerApplication[]
  @@index([cropCycleId, createdAt])
}

model FertilizerProduct {
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  ownerId String
  name String @db.VarChar(100)
  composition Json
  source String @db.VarChar(500)
  manufacturer String? @db.VarChar(120)
  packSizeKg Decimal? @db.Decimal(10,3)
  organic Boolean @default(false)
  createdAt DateTime @default(now())
  prices FertilizerPrice[]
  stockMovements FertilizerStockMovement[]
  @@index([ownerId])
}

model FertilizerStockMovement {
  id String @id @default(cuid())
  productId String
  requestKey String @db.VarChar(64)
  kind String @db.VarChar(16)
  deltaKg Decimal @db.Decimal(12,3)
  occurredOn DateTime @db.Date
  batchNumber String? @db.VarChar(80)
  supplier String? @db.VarChar(120)
  note String? @db.VarChar(300)
  totalCost Decimal? @db.Decimal(12,2)
  recordedAt DateTime @default(now())
  product FertilizerProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, requestKey])
  @@index([productId, occurredOn])
}

model FertilizerPrice {
  id String @id @default(cuid())
  productId String
  price Decimal @db.Decimal(12,2)
  bagKg Decimal @db.Decimal(10,3)
  recordedAt DateTime @default(now())
  product FertilizerProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([productId, recordedAt])
}

model FertilizerApplication {
  id String @id @default(cuid())
  cropCycleId String
  planId String?
  requestKey String @unique @db.VarChar(191)
  slot String? @unique @db.VarChar(191)
  product String @db.VarChar(100)
  quantityKg Decimal @db.Decimal(12,3)
  composition Json
  scheduledDate DateTime @db.Date
  appliedDate DateTime? @db.Date
  offsetDays Int?
  status String @default("PLANNED") @db.VarChar(16)
  method String? @db.VarChar(120)
  cost Decimal? @db.Decimal(12,2)
  expenseId String? @unique
  notes String? @db.VarChar(1000)
  version Int @default(1)
  revisions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Restrict)
  plan FertilizerPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  @@index([cropCycleId, status, scheduledDate])
}

model FertilizerAnalysis {
  id String @id @default(cuid())
  cropCycleId String
  kind String @db.VarChar(16)
  metadata Json
  image Bytes? @db.LongBlob
  mediaType String? @db.VarChar(40)
  createdAt DateTime @default(now())
  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Restrict)
  @@index([cropCycleId, createdAt])
}

model CropProtectionAssessment {
  assignedExpertId String? @db.VarChar(191)
  id String @id @default(cuid())
  userId String
  cropCycleId String?
  cropName String @db.VarChar(120)
  input Json
  findings Json
  reviews CropProtectionReview[]
  recoveryStatus String @default("Expert review required") @db.VarChar(40)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  cropCycle CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  photos CropProtectionPhoto[]
  followups CropProtectionFollowup[]
  @@index([userId, createdAt])
}
model CropProtectionPhoto {
  id String @id @default(cuid())
  assessmentId String
  kind String @db.VarChar(40)
  mediaType String @db.VarChar(30)
  bytes Bytes @db.LongBlob
  assessment CropProtectionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId])
}
model CropProtectionFollowup {
  id String @id @default(cuid())
  assessmentId String
  status String @db.VarChar(40)
  notes String @db.Text
  createdAt DateTime @default(now())
  assessment CropProtectionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId, createdAt])
}

model CropProtectionExpertGrant {
  userId String @id
  role String @db.VarChar(40)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model CropProtectionReview {
  id String @id @default(cuid())
  assessmentId String
  reviewerId String @db.VarChar(191)
  reviewerName String @db.VarChar(191)
  observations String @db.Text
  suspectedCause String @db.VarChar(500)
  verificationStatus String @db.VarChar(60)
  laboratoryEvidence Json
  createdAt DateTime @default(now())
  assessment CropProtectionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId, createdAt])
}

model AssistantConversation {
  id          String             @id @default(cuid())
  userId      String
  cropCycleId String?
  title       String             @db.VarChar(180)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropCycle   CropCycle?         @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  messages    AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([cropCycleId])
}

model AssistantMessage {
  id             String               @id @default(cuid())
  conversationId String
  sequence       Int
  requestId      String?              @db.VarChar(80)
  role           String               @db.VarChar(12)
  content        String               @db.Text
  mode           String?              @db.VarChar(12)
  advice         Json?
  sources        Json?
  createdAt      DateTime             @default(now())
  conversation  AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
  @@unique([conversationId, sequence])
  @@unique([conversationId, requestId])
}

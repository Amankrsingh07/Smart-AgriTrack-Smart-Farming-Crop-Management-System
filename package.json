{
  "name": "agritrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && next dev --turbopack",
    "build": "next build",
    "prebuild": "node scripts/check-generated-types.mjs && prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/deploy-migrations.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "mandi:update": "node --import tsx scripts/update-mandi-snapshot.ts",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/check-generated-types.mjs",
    "test:e2e": "playwright test",
    "test:db:setup": "node scripts/push-test-schema.mjs",
    "fertilizer:coverage": "node --import tsx scripts/generate-fertilizer-coverage.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.4.5",
    "next-intl": "^4.14.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.5",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}

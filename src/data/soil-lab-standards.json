        "basis": "P",
        "unit": "kg/acre",
        "lowBelow": 5,
        "mediumThrough": 9,
        "highThrough": 20
      },
      "potassium": {
        "basis": "K2O",
        "unit": "kg/acre",
        "deficientBelow": 55,
        "sufficientAbove": 55
      },
      "organicCarbon": {
        "basis": "OC",
        "unit": "%",
        "lowBelow": 0.4,
        "mediumThrough": 0.75
      },
      "nitrogen": null,
      "note": "OC bands are the source's nitrogen-availability index, not a direct N assay. Direct nitrogen readings are not classified by this standard. At exactly 55 kg K2O/acre the published strict inequalities leave the K class unspecified. No fertilizer adjustment is calculated from these classes.",

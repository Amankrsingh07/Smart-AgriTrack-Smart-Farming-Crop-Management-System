# Required for the local MySQL database.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/agritrack"

# Replace with a random secret of at least 32 characters.
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional online services. Keep real credentials in .env.local, never here.
DATA_GOV_IN_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
